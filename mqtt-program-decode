    data:
      option: '{{ ''-'' if p1_f_q == -1 else ''%02d'' | format((p1_f_q % 4) * 15) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_h2_debut
    data:
      option: '{{ ''-'' if p1_c2_d_q == -1 else ''%02d'' | format((p1_c2_d_q / 4)|int) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_m2_debut
    data:
      option: '{{ ''-'' if p1_c2_d_q == -1 else ''%02d'' | format((p1_c2_d_q % 4) * 15) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_h2_fin
    data:
      option: '{{ ''-'' if p1_c2_f_q == -1 else ''%02d'' | format((p1_c2_f_q / 4)|int) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_m2_fin
    data:
      option: '{{ ''-'' if p1_c2_f_q == -1 else ''%02d'' | format((p1_c2_f_q % 4) * 15) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_h3_debut
    data:
      option: '{{ ''-'' if p1_c3_d_q == -1 else ''%02d'' | format((p1_c3_d_q / 4)|int) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_m3_debut
    data:
      option: '{{ ''-'' if p1_c3_d_q == -1 else ''%02d'' | format((p1_c3_d_q % 4) * 15) }}'
  - action: input_select.select_option
    target:
      entity_id: input_select.tild_filtration_p1_h3_fin
    data:
      option: '{{ ''-'' if p1_c3_f_q == -1 else ''%02d'' | format((p1_c3_f_q / 4)|int) }}'
  - action: input_select.select_option
    target:
