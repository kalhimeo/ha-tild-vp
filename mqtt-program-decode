    data:
      option: '{{ ''-'' if p1_c3_f_q == -1 else ''%02d'' | format((p1_c3_f_q % 4) * 15) }}'
  - action: input_boolean.turn_{{ 'on' if p2_actif else 'off' }}
    target:
      entity_id: input_boolean.tild_filtration_p2_active
  - action: input_boolean.turn_{{ 'on' if p2_thermo_actif else 'off' }}
    target:
